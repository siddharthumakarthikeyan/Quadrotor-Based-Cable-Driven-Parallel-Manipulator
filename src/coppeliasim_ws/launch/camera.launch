    <remap from="image_rect" to="/robot_7/kinect_7/camera/depth_image"/>
    <remap from="points" to="/robot_7/kinect_7/camera/depth/points"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="nodelet_8" args="load depth_image_proc/point_cloud_xyz nodelet_manager">
    <remap from="camera_info" to="/robot_8/kinect_8/camera/camera_info"/>
    <remap from="image_rect" to="/robot_8/kinect_8/camera/depth_image"/>
