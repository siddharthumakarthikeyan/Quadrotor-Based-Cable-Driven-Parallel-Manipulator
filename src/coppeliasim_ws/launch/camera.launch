<launch>
  <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager" />

  <node pkg="nodelet" type="nodelet" name="nodelet_1" args="load depth_image_proc/point_cloud_xyz nodelet_manager">
    <remap from="camera_info" to="/drone_1/kinect_1/camera/camera_info"/>
    <remap from="image_rect" to="/drone_1/kinect_1/camera/depth_image"/>
    <remap from="points" to="/drone_1/kinect_1/camera/depth/points"/>
  </node>
