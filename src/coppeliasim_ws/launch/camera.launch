    <remap from="image_rect" to="/robot_5/kinect_5/camera/depth_image"/>
    <remap from="points" to="/robot_5/kinect_5/camera/depth/points"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="nodelet_6" args="load depth_image_proc/point_cloud_xyz nodelet_manager">
    <remap from="camera_info" to="/robot_6/kinect_6/camera/camera_info"/>
